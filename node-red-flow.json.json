    {
        "id": "543d257a3e81ca07",
        "type": "function",
        "z": "ccebc99eec36fe98",
        "name": "SmartDry Heartbeat Monitor",
        "func": "\nconst TIMEOUT = 120000; // 120 detik\nconst CHECK_TOPIC = \"__smartdry_heartbeat_check__\";\nconst MQTT_TOPIC = \"smartdry/zaldi/monitoring\";\n\nconst now = Date.now();\n\nlet lastSeen = context.get(\"lastSeen\") || 0;\nlet lastStatus = context.get(\"lastStatus\") || null;\n\n// Pesan dari ESP32 melalui MQTT\nif (msg.topic === MQTT_TOPIC) {\n    if (msg.payload && typeof msg.payload === \"object\") {\n        lastSeen = now;\n        context.set(\"lastSeen\", lastSeen);\n    }\n}\n\n// Pemeriksaan berkala dari Inject\nelse if (msg.topic !== CHECK_TOPIC) {\n    return null;\n}\n\n// Tentukan status koneksi data\nconst elapsed = now - lastSeen;\n\nconst newStatus =\n    lastSeen > 0 && elapsed < TIMEOUT\n        ? \"ONLINE\"\n        : \"OFFLINE\";\n\n// Perbarui status hanya ketika berubah\nif (newStatus !== lastStatus) {\n\n    context.set(\"lastStatus\", newStatus);\n\n    node.status({\n        fill: newStatus === \"ONLINE\" ? \"green\" : \"red\",\n        shape: \"dot\",\n        text: newStatus\n    });\n\n    return {\n        topic: \"smartdry/system/status\",\n        payload: newStatus\n    };\n}\n\nreturn null;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "\ncontext.set(\"lastSeen\", 0);\ncontext.set(\"lastStatus\", null);\n",
        "finalize": "",
        "libs": [],
        "x": 480,
        "y": 820,
        "wires": [
            [
                "3876538b793cc928"
            ]
        ]
    },
    {
