    {
        "id": "6cb336202e2631f9",
        "type": "ui-template",
        "z": "ccebc99eec36fe98",
        "group": "bed2f5737d6413be",
        "page": "",
        "ui": "",
        "name": "Sensor Health Card",
        "order": 1,
        "width": "12",
        "height": "5",
        "head": "",
        "format": "\n<template>\n  <div class=\"sd-health-card\">\n\n    <div class=\"sd-health-header\">\n      <div>\n        <div class=\"sd-health-title\">\n          SENSOR HEALTH MONITORING\n        </div>\n        <div class=\"sd-health-subtitle\">\n          SmartDry Sensor Diagnostics\n        </div>\n      </div>\n\n      <span class=\"sd-health-badge\"\n            :class=\"healthClass\">\n        {{ sensorHealth }}\n      </span>\n    </div>\n\n    <div class=\"sd-health-grid\">\n\n      <div class=\"sd-health-sensor\">\n        <div class=\"sd-health-name\">DHT22</div>\n        <div class=\"sd-health-value\"\n             :class=\"dhtClass\">\n          {{ dhtStatus }}\n        </div>\n        <div class=\"sd-health-detail\">\n          Temperature & Humidity\n        </div>\n      </div>\n\n      <div class=\"sd-health-sensor\">\n        <div class=\"sd-health-name\">HX711</div>\n        <div class=\"sd-health-value\"\n             :class=\"hxClass\">\n          {{ hxStatus }}\n        </div>\n        <div class=\"sd-health-detail\">\n          Load Cell Monitoring\n        </div>\n      </div>\n\n    </div>\n\n    <div class=\"sd-health-message\">\n      {{ healthMessage }}\n    </div>\n\n  </div>\n</template>\n\n<script>\nexport default {\n  computed: {\n    data() {\n      return this.msg?.payload || {};\n    },\n\n    sensorHealth() {\n      return this.data.sensor_health || \"WAITING\";\n    },\n\n    dhtStatus() {\n      return this.data.dht_status || \"WAITING\";\n    },\n\n    hxStatus() {\n      return this.data.hx711_status || \"WAITING\";\n    },\n\n    healthClass() {\n      if (this.sensorHealth === \"OK\") return \"ok\";\n      if (this.sensorHealth === \"WAITING\") return \"waiting\";\n      return \"error\";\n    },\n\n    dhtClass() {\n      return this.dhtStatus === \"OK\"\n        ? \"ok\"\n        : this.dhtStatus === \"ERROR\"\n          ? \"error\"\n          : \"waiting\";\n    },\n\n    hxClass() {\n      return this.hxStatus === \"OK\"\n        ? \"ok\"\n        : this.hxStatus === \"ERROR\"\n          ? \"error\"\n          : \"waiting\";\n    },\n\n    healthMessage() {\n      if (this.sensorHealth === \"OK\") {\n        return \"All sensors are responding normally.\";\n      }\n\n      if (this.sensorHealth === \"DHT22_ERROR\") {\n        return \"Warning: DHT22 sensor reading failed!\";\n      }\n\n      if (this.sensorHealth === \"HX711_ERROR\") {\n        return \"Warning: HX711 sensor reading failed!\";\n      }\n\n      if (this.sensorHealth === \"MULTIPLE_ERRORS\") {\n        return \"Critical: Multiple sensor failures detected!\";\n      }\n\n      return \"Waiting for ESP32 sensor health data...\";\n    }\n  }\n}\n</script>\n\n<style>\n.sd-health-card {\n  padding: 18px 22px;\n  background: #F8FAFC;\n  border: 1px solid #E2E8F0;\n  border-radius: 14px;\n  font-family: Arial, sans-serif;\n  box-sizing: border-box;\n}\n\n.sd-health-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 10px;\n}\n\n.sd-health-title {\n  font-size: 17px;\n  font-weight: 700;\n  color: #1E293B;\n}\n\n.sd-health-subtitle {\n  font-size: 12px;\n  color: #64748B;\n  margin-top: 5px;\n}\n\n.sd-health-badge {\n  padding: 8px 14px;\n  border-radius: 20px;\n  font-size: 12px;\n  font-weight: 700;\n  overflow-wrap: anywhere;\n}\n\n.sd-health-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 12px;\n  margin-top: 18px;\n}\n\n.sd-health-sensor {\n  padding: 14px;\n  background: white;\n  border: 1px solid #E2E8F0;\n  border-radius: 10px;\n}\n\n.sd-health-name {\n  font-size: 14px;\n  font-weight: 700;\n  color: #334155;\n}\n\n.sd-health-value {\n  margin-top: 8px;\n  font-size: 20px;\n  font-weight: 700;\n}\n\n.sd-health-detail {\n  margin-top: 7px;\n  font-size: 11px;\n  color: #64748B;\n}\n\n.sd-health-message {\n  margin-top: 15px;\n  font-size: 12px;\n  color: #475569;\n}\n\n.sd-health-card .ok {\n  color: #15803D;\n}\n\n.sd-health-badge.ok {\n  background: #DCFCE7;\n}\n\n.sd-health-card .error {\n  color: #B91C1C;\n}\n\n.sd-health-badge.error {\n  background: #FEE2E2;\n}\n\n.sd-health-card .waiting {\n  color: #64748B;\n}\n\n.sd-health-badge.waiting {\n  background: #E2E8F0;\n}\n</style>\n",
