        "format": "\n<template>\n  <div class=\"system-status-card\">\n    <div>\n      <div class=\"system-title\">SYSTEM STATUS</div>\n      <div class=\"system-subtitle\">\n        SmartDry Data Connection\n      </div>\n    </div>\n\n    <div\n      class=\"system-badge\"\n      :class=\"{\n        online: msg?.payload === 'ONLINE',\n        offline: msg?.payload === 'OFFLINE'\n      }\"\n    >\n      <span class=\"status-dot\"></span>\n      {{ msg?.payload || 'WAITING FOR DATA' }}\n    </div>\n  </div>\n</template>\n\n<style>\n.system-status-card {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 16px;\n  padding: 16px 22px;\n  background: #F8FAFC;\n  border: 1px solid #E2E8F0;\n  border-radius: 14px;\n  min-height: 86px;\n}\n\n.system-title {\n  font-size: 17px;\n  font-weight: 700;\n  color: #1E293B;\n}\n\n.system-subtitle {\n  font-size: 12px;\n  color: #64748B;\n  margin-top: 4px;\n}\n\n.system-badge {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 10px 16px;\n  border-radius: 30px;\n  font-size: 12px;\n  font-weight: 700;\n  background: #E2E8F0;\n  color: #475569;\n}\n\n.status-dot {\n  width: 9px;\n  height: 9px;\n  border-radius: 50%;\n  background: currentColor;\n}\n\n.system-badge.online {\n  background: #DCFCE7;\n  color: #15803D;\n}\n\n.system-badge.offline {\n  background: #FEE2E2;\n  color: #B91C1C;\n}\n</style>\n",
