        "name": "Safe Sensor Display",
        "func": "\nconst data = msg.payload;\n\nif (!data || typeof data !== \"object\") {\n    return null;\n}\n\n// Validasi nilai sensor\nfunction safeValue(value, min, max) {\n    if (\n        value === null ||\n        value === undefined ||\n        value === \"\"\n    ) {\n        return \"--\";\n    }\n\n    const number = Number(value);\n\n    if (\n        !Number.isFinite(number) ||\n        number < min ||\n        number > max\n    ) {\n        return \"--\";\n    }\n\n    return number;\n}\n\n// Periksa status kedua sensor\nconst dhtError = data.dht_status !== \"OK\";\nconst hxError = data.hx711_status !== \"OK\";\n\n// Siapkan data aman khusus tampilan\nmsg.payload = {\n    ...data,\n\n    temperature: dhtError\n        ? \"--\"\n        : safeValue(data.temperature, -40, 80),\n\n    humidity: dhtError\n        ? \"--\"\n        : safeValue(data.humidity, 0, 100),\n\n    water_mass: hxError\n        ? \"--\"\n        : safeValue(data.water_mass, 0, 10000)\n};\n\n// Status Function\nnode.status({\n    fill: dhtError || hxError ? \"red\" : \"green\",\n    shape: \"dot\",\n    text: dhtError || hxError\n        ? \"SENSOR ERROR\"\n        : \"DISPLAY READY\"\n});\n\nreturn msg;\n",
