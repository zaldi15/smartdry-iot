    {
        "id": "c2f42f94210df847",
        "type": "function",
        "z": "ccebc99eec36fe98",
        "name": "Prepare Log Data",
        "func": "\nconst data = msg.payload;\n\nif (!data || typeof data !== \"object\") {\n    return null;\n}\n\n// Validasi angka untuk CSV\nfunction safeNumber(value, min, max) {\n    if (\n        value === null ||\n        value === undefined ||\n        value === \"\"\n    ) {\n        return \"\";\n    }\n\n    const number = Number(value);\n\n    if (\n        !Number.isFinite(number) ||\n        number < min ||\n        number > max\n    ) {\n        return \"\";\n    }\n\n    return number;\n}\n\n// Timestamp WIB\nconst waktu = new Date().toLocaleString(\"sv-SE\", {\n    timeZone: \"Asia/Jakarta\",\n    hour12: false\n});\n\n// Status sensor\nconst dhtError = data.dht_status === \"ERROR\";\nconst hxError = data.hx711_status === \"ERROR\";\n\n// Tetap gunakan 8 kolom CSV\nmsg.payload = {\n    timestamp: waktu,\n\n    temperature: dhtError\n        ? \"\"\n        : safeNumber(data.temperature, -40, 80),\n\n    humidity: dhtError\n        ? \"\"\n        : safeNumber(data.humidity, 0, 100),\n\n    water_mass: hxError\n        ? \"\"\n        : safeNumber(data.water_mass, 0, 10000),\n\n    fan_speed: data.fan_speed ?? \"\",\n    fan_pwm: safeNumber(data.fan_pwm, 0, 100),\n\n    safety_status: data.safety_status ?? \"\",\n    safety_action: data.safety_action ?? \"\"\n};\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 110,
        "y": 280,
