    {
        "id": "8f0962194479480a",
        "type": "function",
        "z": "ccebc99eec36fe98",
        "name": "Drying Status",
        "func": "\nconst data = msg.payload;\n\n// Validasi payload\nif (!data || typeof data !== \"object\") {\n    return null;\n}\n\nconst rawHumidity = data.humidity;\n\n// Jika DHT22 mengalami error\nif (\n    data.dht_status === \"ERROR\" ||\n    rawHumidity === null ||\n    rawHumidity === undefined ||\n    rawHumidity === \"\"\n) {\n    msg.payload = \"SENSOR ERROR\";\n    return msg;\n}\n\nconst humidity = Number(rawHumidity);\n\n// Validasi nilai humidity\nif (\n    !Number.isFinite(humidity) ||\n    humidity < 0 ||\n    humidity > 100\n) {\n    msg.payload = \"SENSOR ERROR\";\n    return msg;\n}\n\n// Klasifikasi berdasarkan kelembapan\nif (humidity >= 60) {\n    msg.payload = \"INITIAL DRYING\";\n}\n\nelse if (humidity >= 50) {\n    msg.payload = \"DRYING IN PROGRESS\";\n}\n\nelse {\n    msg.payload = \"FINAL DRYING STAGE\";\n}\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 240,
        "y": 340,
        "wires": [
            [
                "cfaccdda1efccaf0"
            ]
        ]
    },
    {
        "id": "cfaccdda1efccaf0",
        "type": "ui-template",
        "z": "ccebc99eec36fe98",
        "group": "bed2f5737d6413be",
        "page": "",
        "ui": "",
        "name": "SmartDry Status Card",
        "order": 6,
        "width": "12",
        "height": "2",
        "head": "",
        "format": "\n<template>\n  <div class=\"sd-drying-card\" :class=\"statusClass\">\n\n    <div class=\"sd-drying-header\">\n      <div>\n        <div class=\"sd-drying-title\">\n          DRYING STATUS\n        </div>\n        <div class=\"sd-drying-subtitle\">\n          SmartDry Drying Stage Monitoring\n        </div>\n      </div>\n\n      <span class=\"sd-drying-badge\">\n        {{ dryingStatus }}\n      </span>\n    </div>\n\n    <div class=\"sd-drying-message\">\n      {{ statusMessage }}\n    </div>\n\n  </div>\n</template>\n\n<script>\nexport default {\n  computed: {\n    dryingStatus() {\n      const value = this.msg?.payload;\n\n      const validStatuses = [\n        \"INITIAL DRYING\",\n        \"DRYING IN PROGRESS\",\n        \"FINAL DRYING STAGE\",\n        \"SENSOR ERROR\"\n      ];\n\n      return validStatuses.includes(value)\n        ? value\n        : \"WAITING\";\n    },\n\n    statusClass() {\n      if (this.dryingStatus === \"SENSOR ERROR\") {\n        return \"error\";\n      }\n\n      if (this.dryingStatus === \"INITIAL DRYING\") {\n        return \"initial\";\n      }\n\n      if (this.dryingStatus === \"DRYING IN PROGRESS\") {\n        return \"progress\";\n      }\n\n      if (this.dryingStatus === \"FINAL DRYING STAGE\") {\n        return \"final\";\n      }\n\n      return \"waiting\";\n    },\n\n    statusMessage() {\n      if (this.dryingStatus === \"SENSOR ERROR\") {\n        return \"DHT22 reading failed. Drying stage cannot be determined.\";\n      }\n\n      if (this.dryingStatus === \"INITIAL DRYING\") {\n        return \"High ambient humidity detected.\";\n      }\n\n      if (this.dryingStatus === \"DRYING IN PROGRESS\") {\n        return \"Moderate ambient humidity detected.\";\n      }\n\n      if (this.dryingStatus === \"FINAL DRYING STAGE\") {\n        return \"Low ambient humidity detected.\";\n      }\n\n      return \"Waiting for valid sensor data...\";\n    }\n  }\n}\n</script>\n\n<style>\n.sd-drying-card {\n  padding: 20px 22px;\n  border-radius: 14px;\n  border: 1px solid #E2E8F0;\n  background: #F8FAFC;\n  box-sizing: border-box;\n  font-family: Arial, sans-serif;\n}\n\n.sd-drying-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  flex-wrap: wrap;\n  gap: 12px;\n}\n\n.sd-drying-title {\n  font-size: 18px;\n  font-weight: 700;\n  color: #1E293B;\n}\n\n.sd-drying-subtitle {\n  font-size: 12px;\n  color: #64748B;\n  margin-top: 5px;\n}\n\n.sd-drying-badge {\n  padding: 9px 15px;\n  border-radius: 24px;\n  font-size: 12px;\n  font-weight: 700;\n}\n\n.sd-drying-message {\n  margin-top: 18px;\n  font-size: 14px;\n}\n\n.sd-drying-card.initial {\n  background: #FFF7ED;\n  border-color: #FED7AA;\n  color: #C2410C;\n}\n\n.initial .sd-drying-badge {\n  background: #FFEDD5;\n  color: #C2410C;\n}\n\n.sd-drying-card.progress {\n  background: #FFFBEB;\n  border-color: #FDE68A;\n  color: #A16207;\n}\n\n.progress .sd-drying-badge {\n  background: #FEF3C7;\n  color: #A16207;\n}\n\n.sd-drying-card.final {\n  background: #F0FDF4;\n  border-color: #BBF7D0;\n  color: #15803D;\n}\n\n.final .sd-drying-badge {\n  background: #DCFCE7;\n  color: #15803D;\n}\n\n.sd-drying-card.error {\n  background: #FEF2F2;\n  border-color: #FECACA;\n  color: #B91C1C;\n}\n\n.error .sd-drying-badge {\n  background: #FEE2E2;\n  color: #B91C1C;\n}\n\n.sd-drying-card.waiting {\n  color: #64748B;\n}\n\n.waiting .sd-drying-badge {\n  background: #E2E8F0;\n  color: #475569;\n}\n</style>\n",
        "noerr": 0,
        "storeOutMessages": true,
        "passthru": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 300,
        "y": 460,
        "wires": [
            []
        ]
    },
