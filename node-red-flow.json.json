    {
        "id": "15294c8b4a14fa64",
        "type": "ui-template",
        "z": "ccebc99eec36fe98",
        "group": "bed2f5737d6413be",
        "page": "",
        "ui": "",
        "name": "Temperature Safety Alert",
        "order": 3,
        "width": "12",
        "height": "4",
        "head": "",
        "format": "\n<template>\n  <div class=\"sd-safety-card\"\n       :class=\"safetyStatus\">\n\n    <div class=\"sd-safety-header\">\n      <div>\n        <div class=\"sd-safety-title\">\n          TEMPERATURE SAFETY ALERT\n        </div>\n        <div class=\"sd-safety-subtitle\">\n          SmartDry Temperature Monitoring\n        </div>\n      </div>\n\n      <span class=\"sd-safety-badge\">\n        {{ safetyStatus.toUpperCase() }}\n      </span>\n    </div>\n\n    <div class=\"sd-safety-reading\">\n      <div class=\"sd-safety-temp\">\n        {{ temperature !== null\n          ? temperature.toFixed(1) + ' °C'\n          : '-- °C' }}\n      </div>\n    </div>\n\n    <div class=\"sd-safety-message\">\n      {{ safetyMessage }}\n    </div>\n\n  </div>\n</template>\n\n<script>\nexport default {\n  computed: {\n    temperature() {\n      const value = this.msg?.payload?.temperature;\n\n      if (value === null ||\n          value === undefined ||\n          value === \"\") {\n        return null;\n      }\n\n      const number = Number(value);\n\n      return Number.isFinite(number)\n        ? number\n        : null;\n    },\n\n    safetyStatus() {\n      if (this.temperature === null) {\n        return \"waiting\";\n      }\n\n      if (this.temperature >= 50) {\n        return \"critical\";\n      }\n\n      if (this.temperature >= 45) {\n        return \"warning\";\n      }\n\n      return \"normal\";\n    },\n\n    safetyMessage() {\n      if (this.safetyStatus === \"critical\") {\n        return \"Critical temperature threshold exceeded!\";\n      }\n\n      if (this.safetyStatus === \"warning\") {\n        return \"High temperature detected. Check the system.\";\n      }\n\n      if (this.safetyStatus === \"normal\") {\n        return \"Temperature is below the test warning limit.\";\n      }\n\n      return \"Waiting for temperature data...\";\n    }\n  }\n}\n</script>\n\n<style>\n.sd-safety-card {\n  padding: 18px 22px;\n  border-radius: 14px;\n  border: 1px solid #E2E8F0;\n  background: #F8FAFC;\n  font-family: Arial, sans-serif;\n}\n\n.sd-safety-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 12px;\n}\n\n.sd-safety-title {\n  font-size: 17px;\n  font-weight: 700;\n  color: #1E293B;\n}\n\n.sd-safety-subtitle {\n  font-size: 12px;\n  color: #64748B;\n  margin-top: 5px;\n}\n\n.sd-safety-badge {\n  padding: 9px 16px;\n  border-radius: 24px;\n  font-size: 12px;\n  font-weight: 700;\n}\n\n.sd-safety-reading {\n  margin-top: 18px;\n}\n\n.sd-safety-temp {\n  font-size: 30px;\n  font-weight: 700;\n}\n\n.sd-safety-message {\n  margin-top: 10px;\n  font-size: 13px;\n}\n\n.sd-safety-card.normal {\n  background: #F0FDF4;\n  border-color: #BBF7D0;\n  color: #15803D;\n}\n\n.normal .sd-safety-badge {\n  background: #DCFCE7;\n  color: #15803D;\n}\n\n.sd-safety-card.warning {\n  background: #FFFBEB;\n  border-color: #FDE68A;\n  color: #B45309;\n}\n\n.warning .sd-safety-badge {\n  background: #FEF3C7;\n  color: #B45309;\n}\n\n.sd-safety-card.critical {\n  background: #FEF2F2;\n  border-color: #FECACA;\n  color: #B91C1C;\n}\n\n.critical .sd-safety-badge {\n  background: #FEE2E2;\n  color: #B91C1C;\n}\n\n.sd-safety-card.waiting {\n  color: #64748B;\n}\n\n.waiting .sd-safety-badge {\n  background: #E2E8F0;\n  color: #475569;\n}\n</style>\n",
        "noerr": 0,
        "storeOutMessages": true,
        "passthru": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 730,
        "y": 700,
        "wires": [
            []
        ]
    },
    {
        "id": "65f54f72fdfd3640",
        "type": "ui-template",
        "z": "ccebc99eec36fe98",
        "group": "bed2f5737d6413be",
        "page": "",
        "ui": "",
        "name": "Safety Protection Card",
        "order": 4,
        "width": "12",
        "height": "6",
        "head": "",
        "format": "\n<template>\n  <div class=\"sd-protect\" :class=\"statusClass\">\n\n    <div class=\"sd-protect-header\">\n      <div>\n        <div class=\"sd-protect-title\">\n          SAFETY PROTECTION\n        </div>\n        <div class=\"sd-protect-subtitle\">\n          SmartDry Automatic Protection System\n        </div>\n      </div>\n\n      <span class=\"sd-protect-badge\">\n        {{ safetyStatus }}\n      </span>\n    </div>\n\n    <div class=\"sd-protect-action\">\n      <div class=\"sd-protect-label\">\n        CURRENT SAFETY ACTION\n      </div>\n\n      <div class=\"sd-protect-action-name\">\n        {{ safetyAction }}\n      </div>\n\n      <div class=\"sd-protect-message\">\n        {{ safetyMessage }}\n      </div>\n    </div>\n\n    <div class=\"sd-protect-details\">\n      <div>\n        <span>Fan Speed</span>\n        <strong>{{ fanSpeed }}</strong>\n      </div>\n\n      <div>\n        <span>PWM Duty Cycle</span>\n        <strong>{{ fanPWM }}</strong>\n      </div>\n    </div>\n\n  </div>\n</template>\n\n<script>\nexport default {\n  computed: {\n    data() {\n      return this.msg?.payload || {};\n    },\n\n    safetyStatus() {\n      const value = this.data.safety_status;\n\n      const validStatuses = [\n        \"NORMAL\",\n        \"WARNING\",\n        \"CRITICAL\",\n        \"SENSOR_ERROR\"\n      ];\n\n      return validStatuses.includes(value)\n        ? value\n        : \"WAITING\";\n    },\n\n    statusClass() {\n      if (this.safetyStatus === \"SENSOR_ERROR\") {\n        return \"error\";\n      }\n\n      return this.safetyStatus.toLowerCase();\n    },\n\n    safetyAction() {\n      return this.data.safety_action ||\n        \"WAITING FOR DATA\";\n    },\n\n    fanSpeed() {\n      return this.data.fan_speed || \"--\";\n    },\n\n    fanPWM() {\n      const value = this.data.fan_pwm;\n\n      return value !== null &&\n             value !== undefined\n        ? value + \"%\"\n        : \"--\";\n    },\n\n    safetyMessage() {\n      if (this.safetyStatus === \"SENSOR_ERROR\") {\n        return \"DHT22 reading failed. Fan indicators disabled in simulation.\";\n      }\n\n      if (this.safetyStatus === \"CRITICAL\") {\n        return \"Critical temperature! Cooling override active.\";\n      }\n\n      if (this.safetyStatus === \"WARNING\") {\n        return \"High temperature detected. Cooling override active.\";\n      }\n\n      if (this.safetyStatus === \"NORMAL\") {\n        return \"System operating under normal fan control.\";\n      }\n\n      return \"Waiting for ESP32 safety data...\";\n    }\n  }\n}\n</script>\n\n<style>\n.sd-protect {\n  font-family: Arial, sans-serif;\n  padding: 18px 22px;\n  background: #F8FAFC;\n  border: 1px solid #E2E8F0;\n  border-radius: 14px;\n  box-sizing: border-box;\n}\n\n.sd-protect-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  flex-wrap: wrap;\n  gap: 12px;\n  margin-bottom: 15px;\n}\n\n.sd-protect-title {\n  font-size: 18px;\n  font-weight: 700;\n  color: #1E293B;\n}\n\n.sd-protect-subtitle {\n  font-size: 12px;\n  margin-top: 5px;\n  color: #64748B;\n}\n\n.sd-protect-badge {\n  padding: 9px 16px;\n  border-radius: 25px;\n  font-size: 12px;\n  font-weight: 700;\n  background: #E2E8F0;\n  color: #475569;\n}\n\n.sd-protect-action {\n  padding: 14px;\n  background: #F1F5F9;\n  border-radius: 10px;\n}\n\n.sd-protect-label {\n  font-size: 11px;\n  font-weight: 700;\n  color: #64748B;\n  margin-bottom: 7px;\n}\n\n.sd-protect-action-name {\n  font-size: 18px;\n  font-weight: 700;\n  color: #1E293B;\n  overflow-wrap: anywhere;\n}\n\n.sd-protect-message {\n  font-size: 12px;\n  color: #64748B;\n  margin-top: 7px;\n}\n\n.sd-protect-details {\n  display: flex;\n  gap: 20px;\n  margin-top: 15px;\n}\n\n.sd-protect-details > div {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  gap: 5px;\n}\n\n.sd-protect-details span {\n  font-size: 12px;\n  color: #64748B;\n}\n\n.sd-protect-details strong {\n  font-size: 18px;\n  color: #1E293B;\n}\n\n/* NORMAL */\n.sd-protect.normal {\n  border-color: #BBF7D0;\n}\n\n.sd-protect.normal .sd-protect-badge {\n  background: #DCFCE7;\n  color: #15803D;\n}\n\n/* WARNING */\n.sd-protect.warning {\n  border-color: #FDE68A;\n}\n\n.sd-protect.warning .sd-protect-badge {\n  background: #FEF3C7;\n  color: #B45309;\n}\n\n/* CRITICAL */\n.sd-protect.critical {\n  border-color: #FECACA;\n}\n\n.sd-protect.critical .sd-protect-badge {\n  background: #FEE2E2;\n  color: #B91C1C;\n}\n\n.sd-protect.critical .sd-protect-action {\n  background: #FEF2F2;\n}\n\n.sd-protect.critical .sd-protect-action-name {\n  color: #B91C1C;\n}\n\n/* SENSOR ERROR */\n.sd-protect.error {\n  border-color: #FCA5A5;\n  background: #FFF7F7;\n}\n\n.sd-protect.error .sd-protect-badge {\n  background: #FEE2E2;\n  color: #B91C1C;\n}\n\n.sd-protect.error .sd-protect-action {\n  background: #FEF2F2;\n}\n\n.sd-protect.error .sd-protect-action-name {\n  color: #DC2626;\n}\n\n/* WAITING */\n.sd-protect.waiting .sd-protect-badge {\n  background: #E2E8F0;\n  color: #475569;\n}\n</style>\n",
        "noerr": 0,
        "storeOutMessages": true,
        "passthru": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 820,
        "y": 620,
        "wires": [
            []
        ]
