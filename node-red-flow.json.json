    {
        "id": "2b239631df2f3528",
        "type": "ui-template",
        "z": "ccebc99eec36fe98",
        "group": "bed2f5737d6413be",
        "page": "",
        "ui": "",
        "name": "Fan PWM Card",
        "order": 5,
        "width": "12",
        "height": "5",
        "head": "",
        "format": "\n<template>\n  <div class=\"sd-pwm-card\">\n\n    <div class=\"sd-pwm-header\">\n      <div>\n        <div class=\"sd-pwm-title\">\n          FAN PWM CONTROL\n        </div>\n\n        <div class=\"sd-pwm-subtitle\">\n          SmartDry Automatic Fan System\n        </div>\n      </div>\n\n      <span\n        class=\"sd-pwm-badge\"\n        :class=\"msg?.payload?.fan_speed || 'WAITING'\"\n      >\n        {{ msg?.payload?.fan_speed || 'WAITING' }}\n      </span>\n    </div>\n\n    <div class=\"sd-pwm-value-row\">\n      <span>PWM Duty Cycle</span>\n\n      <strong>\n        {{ msg?.payload?.fan_pwm != null\n          ? msg.payload.fan_pwm + '%'\n          : '--' }}\n      </strong>\n    </div>\n\n    <div class=\"sd-pwm-track\">\n      <div\n        class=\"sd-pwm-fill\"\n        :class=\"msg?.payload?.fan_speed || 'WAITING'\"\n        :style=\"{\n          width: Math.max(0, Math.min(100,\n            Number(msg?.payload?.fan_pwm) || 0\n          )) + '%'\n        }\"\n      ></div>\n    </div>\n\n    <div class=\"sd-pwm-scale\">\n      <span>0%</span>\n      <span>100%</span>\n    </div>\n\n  </div>\n</template>\n\n<style>\n.sd-pwm-card {\n  padding: 18px 22px;\n  background: #F8FAFC;\n  border: 1px solid #E2E8F0;\n  border-radius: 14px;\n  min-height: 130px;\n  font-family: Arial, sans-serif;\n}\n\n.sd-pwm-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 12px;\n  flex-wrap: wrap;\n  margin-bottom: 20px;\n}\n\n.sd-pwm-title {\n  font-size: 17px;\n  font-weight: 700;\n  color: #1E293B;\n}\n\n.sd-pwm-subtitle {\n  font-size: 12px;\n  color: #64748B;\n  margin-top: 4px;\n}\n\n.sd-pwm-badge {\n  padding: 9px 16px;\n  border-radius: 25px;\n  font-size: 12px;\n  font-weight: 700;\n  background: #E2E8F0;\n  color: #475569;\n}\n\n.sd-pwm-badge.LOW {\n  background: #DCFCE7;\n  color: #15803D;\n}\n\n.sd-pwm-badge.MEDIUM {\n  background: #FEF3C7;\n  color: #B45309;\n}\n\n.sd-pwm-badge.HIGH {\n  background: #FEE2E2;\n  color: #B91C1C;\n}\n\n.sd-pwm-value-row {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 12px;\n  font-size: 14px;\n  color: #475569;\n}\n\n.sd-pwm-value-row strong {\n  font-size: 28px;\n  color: #1E293B;\n}\n\n.sd-pwm-track {\n  width: 100%;\n  height: 16px;\n  background: #E2E8F0;\n  border-radius: 20px;\n  overflow: hidden;\n}\n\n.sd-pwm-fill {\n  height: 100%;\n  width: 0%;\n  border-radius: 20px;\n  background: #94A3B8;\n  transition: width 0.5s ease,\n              background 0.5s ease;\n}\n\n.sd-pwm-fill.LOW {\n  background: #22C55E;\n}\n\n.sd-pwm-fill.MEDIUM {\n  background: #EAB308;\n}\n\n.sd-pwm-fill.HIGH {\n  background: #EF4444;\n}\n\n.sd-pwm-scale {\n  display: flex;\n  justify-content: space-between;\n  margin-top: 7px;\n  font-size: 11px;\n  color: #94A3B8;\n}\n</style>\n",
        "noerr": 0,
        "storeOutMessages": true,
        "passthru": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 460,
