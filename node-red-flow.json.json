    {
        "id": "c205f68da8bc1a33",
        "type": "function",
        "z": "ccebc99eec36fe98",
        "name": "Validate DHT Data",
        "func": "\nconst data = msg.payload;\n\n// Pastikan payload berupa object\nif (!data || typeof data !== \"object\") {\n    node.status({\n        fill: \"red\",\n        shape: \"dot\",\n        text: \"INVALID PAYLOAD\"\n    });\n\n    return null;\n}\n\n// Periksa status DHT22\nif (data.dht_status === \"ERROR\") {\n    node.status({\n        fill: \"red\",\n        shape: \"dot\",\n        text: \"DHT22 ERROR\"\n    });\n\n    return null;\n}\n\n// Jangan mengubah null menjadi 0\nif (\n    data.temperature === null ||\n    data.temperature === undefined ||\n    data.humidity === null ||\n    data.humidity === undefined ||\n    data.temperature === \"\" ||\n    data.humidity === \"\"\n) {\n    node.status({\n        fill: \"red\",\n        shape: \"dot\",\n        text: \"SENSOR DATA MISSING\"\n    });\n\n    return null;\n}\n\n// Konversi data\nconst temperature = Number(data.temperature);\nconst humidity = Number(data.humidity);\n\n// Validasi rentang DHT22\nconst validTemperature =\n    Number.isFinite(temperature) &&\n    temperature >= -40 &&\n    temperature <= 80;\n\nconst validHumidity =\n    Number.isFinite(humidity) &&\n    humidity >= 0 &&\n    humidity <= 100;\n\n// Hentikan aliran jika tidak valid\nif (!validTemperature || !validHumidity) {\n    node.status({\n        fill: \"red\",\n        shape: \"dot\",\n        text: \"INVALID SENSOR DATA\"\n    });\n\n    return null;\n}\n\n// Jika valid, teruskan ke Gauge dan Chart\nnode.status({\n    fill: \"green\",\n    shape: \"dot\",\n    text: \"DHT22 VALID\"\n});\n\nreturn msg;\n",
